# Copy to .env and adjust as needed: cp .env.example .env
# Required. Secret shared between internal services; generate with `openssl rand -hex 32`.
INTERNAL_SERVICE_TOKEN=replace-with-random-64-hex-characters
POSTGRES_DB=orderly
POSTGRES_USER=orderly
POSTGRES_PASSWORD=orderly
POSTGRES_PORT=5432
REDIS_PORT=6379
USERS_PORT=8080
TZ=UTC
